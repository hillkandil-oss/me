.DS_Store
*.swp
.idea/
.vscode/

# Never commit credentials. Application passwords, WooCommerce REST keys, and
# Merchant Center/hosting logins stay out of the repository entirely.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json
