#!/usr/bin/env python3
import json, os, subprocess
SCRATCH=os.path.dirname(os.path.abspath(__file__)); AUTH=os.path.join(SCRATCH,".wpauth")
MI="https://kaisercontainers.de/wp-json/wp/v2/menu-items"; MENU=28

def curl(method,url,data=None):
    cmd=["curl","-sS","-m","90","-K",AUTH,"-H","Content-Type:application/json","-X",method,url]
    if data is not None:
        cmd+=["--data","@-"]; p=subprocess.run(cmd,input=json.dumps(data),capture_output=True,text=True)
    else: p=subprocess.run(cmd,capture_output=True,text=True)
    try: return json.loads(p.stdout)
    except: return {"_raw":p.stdout[:200]}

# wipe existing items in menu 28 for idempotency
cur=curl("GET",f"{MI}?menus={MENU}&per_page=100&_fields=id")
if isinstance(cur,list):
    for it in cur: curl("DELETE",f"{MI}/{it['id']}?force=true")

def item(title,order,**kw):
    p={"title":title,"menus":MENU,"status":"publish","menu_order":order}; p.update(kw)
    r=curl("POST",MI,p); return r.get("id")

# top-level
item("Startseite",1,type="custom",url="/")
item("Shop",2,type="post_type",object="page",object_id=9)
container=item("Container",3,type="custom",url="/shop/")
# children of Container
item("Seecontainer",1,type="taxonomy",object="product_cat",object_id=39,parent=container)
item("Lagercontainer",2,type="taxonomy",object="product_cat",object_id=36,parent=container)
item("Garagencontainer",3,type="taxonomy",object="product_cat",object_id=41,parent=container)
item("Gebrauchtcontainer",4,type="taxonomy",object="product_cat",object_id=37,parent=container)
item("Über uns",4,type="post_type",object="page",object_id=120)
item("Kontakt",5,type="post_type",object="page",object_id=119)

# verify
res=curl("GET",f"{MI}?menus={MENU}&per_page=100&_fields=id,title,parent,menu_order,url")
if isinstance(res,list):
    print(f"menu {MENU} now has {len(res)} items:")
    for m in sorted(res,key=lambda x:(x.get('parent',0),x.get('menu_order',0))):
        t=m['title']['rendered'] if isinstance(m['title'],dict) else m['title']
        print(f"   {'  └ ' if m.get('parent') else ''}{t}  (order {m.get('menu_order')})")
